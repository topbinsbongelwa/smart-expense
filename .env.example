# Copy this file to .env and paste the web app config from
# Firebase console -> Project settings -> Your apps -> SDK setup and configuration.
# These are public client identifiers, safe to ship in the app bundle.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Manus AI cloud assistant (OpenAI-compatible chat-completions endpoint).
# Leave both blank to run the built-in on-device fallback engine.
EXPO_PUBLIC_MANUS_API_KEY=
EXPO_PUBLIC_MANUS_API_URL=
EXPO_PUBLIC_MANUS_MODEL=

# Google Gemini assistant. The key is included in client builds; restrict it
# to the Gemini API in Google AI Studio / Google Cloud before using it.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
EXPO_PUBLIC_GEMINI_AUDIO_MODEL=gemini-2.5-flash