rules_version = '2';

// TEMPORARY Firestore rules for the Iskhwama scaffolding.
// Each signed-in user can only touch their own document tree:
//   users/{uid}/expenses/latest
//   users/{uid}/profile/latest
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
