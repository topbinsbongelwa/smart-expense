{
  "expo": {
    "name": "Iskhwama",
    "slug": "iskhwama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iskhwama-bag-logo.png",
    "scheme": "iskhwama",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B5A36",
        "foregroundImage": "./assets/images/iskhwama-bag-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/iskhwama-bag-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B5A36",
          "image": "./assets/images/iskhwama-bag-logo.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Iskhwama to record your voice question for transcription."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
